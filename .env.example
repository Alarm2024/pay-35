# RevenueCat Web / Test Store public SDK key (Project Settings → API keys → Test Store)
REVENUECAT_API_KEY=

# Entitlement identifier — copy the EXACT id from RevenueCat → Product catalog → Entitlements
# (e.g. pro, pay-35 Pro, pay-35-pro). Client also accepts common aliases for Test Store.
REVENUECAT_ENTITLEMENT_ID=pro

# Optional: Linkup search for live web sources (free /search tier only)
LINKUP_API_KEY=

# Server port (Render sets PORT automatically)
PORT=3000
